{
  "name": "cat-games",
  "version": "0.1.0",
  "description": "Two-player terminal chess for overlapping coding-agent runs",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "codechess/companion",
    "codechess/client",
    "codechess/server",
    "codechess/agent",
    "codechess/shared"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run test && npm run typecheck",
    "server": "npm run start --workspace @codechess/server --",
    "server:dev": "npm run dev --workspace @codechess/server --",
    "agent": "npm run dev --workspace @codechess/agent --",
    "ui": "npm run ui --workspace @codechess/client --",
    "ui:mock": "npm run ui:mock --workspace @codechess/client --",
    "prepare": "npm run build --workspace @codechess/companion && node scripts/stage-package.mjs"
  },
  "bin": {
    "codechess": "dist/cli.js"
  },
  "files": [
    "dist",
    "codechess/docs/PUBLIC_DEMO.md"
  ],
  "dependencies": {
    "chess.js": "^1.4.0",
    "terminal-kit": "^3.1.4",
    "ws": "^8.21.3"
  }
}
